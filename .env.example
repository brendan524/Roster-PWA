# Copy to .env on the VPS and fill in. Keep the real values in Passbolt. Never commit .env.

# Public hostname (DNS A record must point at the VPS)
APP_DOMAIN=hr.abgroup.au

# Database password. Letters and numbers only (it goes into a URL).
# Generate:  openssl rand -hex 24
POSTGRES_PASSWORD=

# Secret key used to hash clock-in PINs. Generate once:  openssl rand -hex 32
# NEVER change it after PINs are issued — every PIN would stop working.
PIN_PEPPER=

# The roster spreadsheet ID: the long part of its URL
#   https://docs.google.com/spreadsheets/d/<THIS PART>/edit
ROSTER_SHEET_ID=

# Decides which month tabs count as "this month" and "next month"
TIMEZONE=Australia/Melbourne

# Clock-in PIN length (used from Stage 2)
PIN_LENGTH=6

# Clock in/out: minutes late / early before a punch is flagged
LATE_GRACE_MINUTES=10
EARLY_GRACE_MINUTES=10
# Kiosk locations offered at setup ("Name:onshore|offshore", comma-separated)
KIOSK_LOCATIONS=AB HQ:onshore,WrkPod:offshore

# Off-server backups: ID of the Google Shared Drive (from its URL:
#   https://drive.google.com/drive/folders/<THIS PART>). Leave empty to skip.
# Also needs secrets/backup-passphrase (see README → Backups).
BACKUP_DRIVE_FOLDER_ID=

# Xero (onshore leave balances). From developer.xero.com → your app → Configuration.
# Redirect URI to register there: https://<APP_DOMAIN>/api/admin/xero/callback
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# Email (Stage 4). Google Workspace: a mailbox such as hr@abgroup.au with 2-Step
# Verification on, and an app password from myaccount.google.com/apppasswords.
SMTP_USER=
SMTP_PASSWORD=
# Optional: send as a different address the mailbox is allowed to send as.
MAIL_FROM=
# Where system alerts go (failed backups, Xero disconnected, roster sheet unreadable).
ALERT_EMAIL=
